}\r\n            </td>\r\n        </tr>\r\n\r\n        {% endfor %}\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n<br>\r\n\r\n<h3>Total CSR Budget</h3>\r\n\r\n<p>\r\n    <b>\r\n        {{ frappe.format_value(doc.total_budget, {'fieldtype': 'Currency'}) }}\r\n    </b>\r\n</p>\r\n\r\n<br>\r\n\r\n<h3>CSR Compliance</h3>\r\n\r\n<table style=\"width:100%; border-collapse: collapse;\">\r\n\r\n    <tr>\r\n        <td><b>CSR Form</b></td>\r\n\r\n        <td>\r\n            {% if doc.csr_form %}\r\n                Submitted\r\n            {% else %}\r\n                Pending\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Approval Notes</b></td>\r\n        <td>{{ doc.approval_notes }}</td>\r\n    </tr>\r\n\r\n</table>\r\n\r\n<br><br><br>\r\n\r\n<table style=\"width:100%;\">\r\n\r\n    <tr>\r\n\r\n        <td style=\"text-align:left;\">\r\n            _________________________<br>\r\n            CSR Program Manager\r\n        </td>\r\n\r\n        <td style=\"text-align:right;\">\r\n            _________________________<br>\r\n            Authorized Approver\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>",
