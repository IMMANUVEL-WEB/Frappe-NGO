  "html": "<div style=\"text-align:center; margin-bottom:20px;\">\r\n    <h1>Caritas India</h1>\r\n    <h2>FCRA Project Proposal</h2>\r\n</div>\r\n\r\n<hr>\r\n\r\n<h3>Project Proposal Information</h3>\r\n\r\n<table style=\"width:100%; border-collapse: collapse;\">\r\n\r\n    <tr>\r\n        <td><b>Proposal Title</b></td>\r\n        <td>{{ doc.proposal_title }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Proposal Code</b></td>\r\n        <td>{{ doc.proposal_code }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Sector</b></td>\r\n        <td>{{ doc.sector }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Geography</b></td>\r\n        <td>{{ doc.geography }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Proposal Owner</b></td>\r\n        <td>{{ doc.proposal_owner }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Donor Profile</b></td>\r\n        <td>{{ doc.donor_profile }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Funding Type</b></td>\r\n        <td>{{ doc.funding_type }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Proposed Start Date</b></td>\r\n        <td>{{ frappe.format(doc.proposed_start_date, {'fieldtype': 'Date'}) }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Proposed End Date</b></td>\r\n        <td>{{ frappe.format(doc.proposed_end_date, {'fieldtype': 'Date'}) }}</td>\r\n    </tr>\r\n\r\n</table>\r\n\r\n<br>\r\n\r\n<h3>Budget Breakdown</h3>\r\n\r\n<table border=\"1\" style=\"width:100%; border-collapse: collapse;\">\r\n\r\n    <thead>\r\n        <tr>\r\n            <th>Category</th>\r\n            <th>Description</th>\r\n            <th>Amount</th>\r\n            <th>Currency</th>\r\n            <th>Notes</th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        {% for row in doc.budget_breakdown %}\r\n\r\n        <tr>\r\n            <td>{{ row.category }}</td>\r\n            <td>{{ row.description }}</td>\r\n            <td style=\"text-align:right;\">\r\n                {{ frappe.format_value(row.amount, {'fieldtype': 'Currency'}) }}\r\n            </td>\r\n            <td>{{ row.currency }}</td>\r\n            <td>{{ row.notes }}</td>\r\n        </tr>\r\n\r\n        {% endfor %}\r\n\r\n    </tbody>\r\n\r\n</table>\r\n\r\n<br>\r\n\r\n<h3>Total Budget</h3>\r\n\r\n<p>\r\n    <b>\r\n        {{ frappe.format_value(doc.total_budget, {'fieldtype': 'Currency'}) }}\r\n    </b>\r\n</p>\r\n\r\n<br>\r\n\r\n<h3>Compliance Information</h3>\r\n\r\n<table style=\"width:100%; border-collapse: collapse;\">\r\n\r\n    <tr>\r\n        <td><b>MoU Document</b></td>\r\n        <td>\r\n            {% if doc.mou_document %}\r\n                Attached\r\n            {% else %}\r\n                Not Attached\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>CSR Form</b></td>\r\n        <td>\r\n            {% if doc.csr_form %}\r\n                Attached\r\n            {% else %}\r\n                Not Attached\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>FCRA Receipt No.</b></td>\r\n        <td>{{ doc.fcra_receipt_no }}</td>\r\n    </tr>\r\n\r\n</table>\r\n\r\n<br>\r\n\r\n<h3>Workflow Information</h3>\r\n\r\n<table style=\"width:100%; border-collapse: collapse;\">\r\n\r\n    <tr>\r\n        <td><b>Approval Notes</b></td>\r\n        <td>{{ doc.approval_notes }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Linked Project</b></td>\r\n        <td>{{ doc.linked_project }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><b>Amended From</b></td>\r\n        <td>{{ doc.amended_from }}</td>\r\n    </tr>\r\n\r\n</table>\r\n\r\n<br><br><br>\r\n\r\n<table style=\"width:100%;\">\r\n\r\n    <tr>\r\n\r\n        <td style=\"text-align:left;\">\r\n            _________________________<br>\r\n            Proposal Owner\r\n        </td>\r\n\r\n        <td style=\"text-align:right;\">\r\n            _________________________<br>\r\n            Authorized Signatory\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>",
